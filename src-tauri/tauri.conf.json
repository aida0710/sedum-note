{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sedum Note",
  "version": "0.2.1",
  "identifier": "com.github.aida0710.sedumnote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sedum Note",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "sedum-note",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMkY1Qjg0Q0FBQzNBQTUKUldTbE9xektoRnN2UW1LRWt5MHFWQlVHdU9BMXZNUktabHVzMHdQU0FGczI1RVdpTWVwOGFjQkUK",
      "endpoints": [
        "https://github.com/aida0710/sedum-note/releases/latest/download/latest.json"
      ]
    }
  }
}
