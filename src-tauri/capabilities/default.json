{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "画面から使える Tauri の機能。ファイルは、保存のダイアログで利用者が選んだ場所にだけ書ける（dialog が選んだ場所を fs の範囲に足す）。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-open",
    "fs:allow-write"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows",
    "android"
  ]
}
