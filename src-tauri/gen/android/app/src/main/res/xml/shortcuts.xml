<?xml version="1.0" encoding="utf-8"?>
<!-- アプリのアイコンを長押ししたときに出るショートカット。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="new_note"
        android:shortcutShortLabel="@string/new_note_widget_label">
        <intent
            android:action="com.github.aida0710.sedumnote.action.NEW_NOTE"
            android:targetClass="com.github.aida0710.sedumnote.MainActivity"
            android:targetPackage="com.github.aida0710.sedumnote" />
    </shortcut>
</shortcuts>
